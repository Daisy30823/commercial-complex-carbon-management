<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>商业综合体能耗与碳排放数智管理系统 · 用户注册</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/login.css?v=20260814f"></head>
<body><main class="login-page"><section class="login-card"><a class="back-link" href="${pageContext.request.contextPath}/login.jsp">← 返回登录</a><img class="login-logo" src="${pageContext.request.contextPath}/assets/images/brand-logo.png" alt="商业综合体低碳管理标志"><div class="login-heading"><span>用户注册</span><h1>创建只读访问账号</h1><p>注册后可查看能耗、碳排放和业务分析数据</p></div>
<form id="registerForm" novalidate><label for="username">用户名</label><input id="username" name="username" minlength="4" maxlength="30" pattern="[A-Za-z0-9_]+" required autocomplete="username"><p class="field-hint">4-30 位字母、数字或下划线</p><label for="realName">姓名</label><input id="realName" name="realName" maxlength="60" required autocomplete="name"><label for="phone">手机号</label><input id="phone" name="phone" maxlength="30" autocomplete="tel"><label for="email">邮箱</label><input id="email" name="email" type="email" maxlength="120" autocomplete="email"><label for="password">密码</label><input id="password" name="password" type="password" minlength="8" required autocomplete="new-password"><label for="confirmPassword">确认密码</label><input id="confirmPassword" name="confirmPassword" type="password" minlength="8" required autocomplete="new-password"><button id="registerButton" class="login-button" type="submit">注册账号</button><div id="registerMessage" class="form-error" role="alert" aria-live="polite"></div></form><p class="auth-switch">已有账号？<a href="${pageContext.request.contextPath}/login.jsp">直接登录</a></p></section></main>
<script>const contextPath='${pageContext.request.contextPath}',form=document.getElementById('registerForm'),message=document.getElementById('registerMessage'),button=document.getElementById('registerButton');form.addEventListener('submit',async event=>{event.preventDefault();message.textContent='';if(!form.reportValidity())return;const payload=Object.fromEntries(new FormData(form));if(payload.password!==payload.confirmPassword){message.textContent='两次输入的密码不一致';return}button.disabled=true;button.textContent='正在注册…';try{const response=await fetch(contextPath+'/api/auth/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}),result=await response.json();if(!result.success)throw new Error(result.message||'注册失败');message.style.color='#4f8f62';message.textContent='注册成功，正在返回登录页…';setTimeout(()=>location.href=contextPath+'/login.jsp?registered=1',900)}catch(error){message.style.color='';message.textContent=error.message||'注册失败，请稍后重试'}finally{button.disabled=false;button.textContent='注册账号'}});</script></body></html>
