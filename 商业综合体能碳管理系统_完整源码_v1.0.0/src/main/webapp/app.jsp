<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<% String buildVersion = "20260814f"; %>
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>商业综合体能耗与碳排放数智管理系统</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css?v=<%= buildVersion %>c"><script src="${pageContext.request.contextPath}/assets/vendor/echarts.min.js?v=5.5.1"></script></head>
<body><div class="shell"><aside class="sidebar"><div class="logo"><span>⌁</span><div><strong>碳智管</strong><small>COMMERCIAL CARBON</small></div></div><nav id="nav"><button data-view="dashboard">总览驾驶舱</button><button data-view="complexes">综合体建档</button><button data-view="buildings">建筑管理</button><button data-view="areas">功能区域</button><button data-view="merchants">商户管理</button><button data-view="merchant-bills">商户能碳账单</button><button data-view="meters">计量体系</button><button data-view="devices">计量设备</button><button data-view="energy">能源消费</button><button data-view="carbon">碳核算与因子</button><button data-view="budget">碳预算执行</button><button data-view="alerts">预警整改闭环</button><button data-view="tasks">整改任务</button><button data-view="projects">节能项目评价</button><button data-view="monthly-reports">月度碳报告</button><button data-view="data-quality">数据质量中心</button><button data-view="queries">专题查询</button><button data-view="logs">操作日志</button></nav><button class="logout" id="logout">退出登录</button></aside><main class="main"><header class="topbar"><div><span class="eyebrow">商业综合体 · 低碳运营</span><h1 id="pageTitle">总览驾驶舱</h1></div><div class="top-actions"><label class="context-control">当前商业综合体<select id="complexSelect"></select></label><label class="context-control">统计日期<input id="statDate" type="date"></label><button class="user-menu" id="userMenu">系统管理员</button><button class="icon-btn" id="refresh" title="刷新">↻</button></div></header>
<section id="dashboard" class="view"><div class="hero"><div><span class="eyebrow">全景看能 · 深入析碳 · 高效管碳</span><h2>让每一度能源都可追溯</h2><p>以计量体系串联建筑、区域、商户、预算和整改，让节能决策从真实数据开始。</p></div><svg viewBox="0 0 300 130" aria-hidden="true"><path d="M8 110h280"/><rect x="30" y="65" width="36" height="45" rx="3"/><rect x="78" y="40" width="45" height="70" rx="3"/><rect x="135" y="20" width="42" height="90" rx="3"/><rect x="188" y="52" width="34" height="58" rx="3"/><path d="M18 98c30-35 52 4 79-26 29-32 46 16 78-20 29-32 50-10 100-35"/></svg></div><div class="kpi-grid" id="kpis"></div><div class="chart-grid"><article class="card chart-card"><div class="card-head"><div><h3>能耗与碳排放趋势</h3><p>按统计日期观察趋势和波动</p></div><button class="help-btn" data-help="趋势折线图用于观察时间序列的水平、趋势和异常波动。">?</button></div><div id="trendChart" class="chart"></div></article><article class="card chart-card"><div class="card-head"><div><h3>功能区域碳排放排名</h3><p>识别重点节能对象</p></div><button class="help-btn" data-help="横向柱状图用于比较不同功能区域的碳排放差异。">?</button></div><div id="rankingChart" class="chart chart-ranking"></div></article><article class="card chart-card"><div class="card-head"><div><h3>能源类型碳排放构成</h3><p>判断主要排放来源</p></div><button class="help-btn" data-help="环形图展示各能源类型在总碳排放中的比例结构。">?</button></div><div id="mixChart" class="chart"></div></article><article class="card chart-card"><div class="card-head"><div><h3>日期 × 区域能耗热力</h3><p>日度识别异常高耗能</p></div><button class="help-btn" data-help="热力图用颜色展示日期和区域两个维度上的能耗强弱。">?</button></div><div id="heatChart" class="chart"></div></article><article class="card chart-card"><div class="card-head"><div><h3>区域能碳绩效雷达</h3><p>选择 2—5 个区域比较</p></div><div class="chart-tools"><select id="radarYear"></select><select id="radarMonth"></select><button class="help-btn" data-help="雷达图比较单位能耗、单位碳排、预算率和预警数等多指标表现。">?</button></div></div><div id="radarChart" class="chart"></div></article><article class="card chart-card gauge-card"><div class="card-head"><div><h3>年度碳预算执行率</h3><p>相对年度目标的关键指标</p></div><button class="help-btn" data-help="仪表盘显示实际排放相对于年度碳预算的执行位置。">?</button></div><div id="gaugeChart" class="chart"></div><div id="gaugeMeta" class="metric-meta"></div></article></div></section>
<section id="generic" class="view"><div class="card"><div class="toolbar"><div><h2 id="tableTitle">数据列表</h2><p id="tableHint">维护当前商业综合体的业务数据</p></div><div><select id="logModule" hidden><option value="">全部模块</option><option>综合体管理</option><option>建筑管理</option><option>能源消费</option><option>碳核算</option><option>碳预算</option><option>预警整改</option><option>节能项目</option><option>月度报告</option></select><select id="logType" hidden><option value="">全部操作</option><option value="insert">新增</option><option value="update">修改</option><option value="select">查询</option><option value="delete">删除</option><option value="login">登录</option><option value="logout">退出</option><option value="audit">审核</option><option value="export">导出</option><option value="generate">生成</option></select><input id="logUser" placeholder="操作用户" hidden><input id="logStart" type="date" title="开始日期" hidden><input id="logEnd" type="date" title="结束日期" hidden><input id="keyword" placeholder="输入关键词"><button class="btn primary" id="search">查询</button><button class="btn ghost" id="reset">重置</button><button class="btn mint" id="exportLogs" hidden>导出 CSV</button><button class="btn mint" id="add">新增</button></div></div><div class="table-wrap"><table><thead id="thead"></thead><tbody id="tbody"></tbody></table></div><div id="tableState" class="table-state"></div></div></section>
<section id="meters" class="view"><div class="meter-layout card"><div class="tree-panel"><div class="toolbar"><div><h2>分级计量体系</h2><p>展示综合体、建筑、区域和商户之间的分级能源计量关系。</p></div><div><button class="btn ghost" id="expandTree">展开全部</button><button class="btn ghost" id="collapseTree">收起全部</button><button class="btn mint" id="addRoot">新增根节点</button></div></div><input id="treeSearch" class="tree-search" placeholder="搜索节点名称或编码"><div id="tree" class="tree"></div></div><div class="node-form"><h2>当前节点信息</h2><form id="nodeForm"><input type="hidden" name="meterNodeId"><label>节点名称<input name="nodeName" required></label><label>节点编码<input name="nodeCode" required></label><label>节点类型<select name="nodeType"><option value="root">综合体</option><option value="building">建筑</option><option value="area">区域</option><option value="merchant">商户</option><option value="meter">设备</option></select></label><label>上级节点 ID<input name="parentNodeId" type="number"></label><label>节点层级<input name="nodeLevel" type="number" value="1"></label><label>备注<textarea name="remark"></textarea></label><div class="form-actions"><button class="btn ghost" type="button" id="cancelNode">取消</button><button class="btn primary" type="submit">保存节点</button><button class="btn danger" type="button" id="deleteNode">停用节点</button></div></form></div></div></section>
<section id="queries" class="view"><div class="card"><div class="toolbar"><div><h2>专题查询中心</h2><p>选择业务查询类型和条件，以表格方式查看存储过程返回结果。</p></div></div><div class="query-tabs" id="queryTabs"></div><div id="queryFilters" class="query-filters"></div><div class="query-actions"><button class="btn primary" id="runQuery">查询</button><button class="btn ghost" id="resetQuery">重置</button><button class="btn mint" id="exportQuery">导出 CSV</button></div><div id="queryResult" class="query-result"></div></div></section>
<section id="merchant-bills" class="view module-view"><div class="card"><div class="toolbar"><div><h2>商户能耗与碳排放账单</h2><p>直计能耗与公共能耗分摊按能源类型分别核算，汇总仅使用费用、tce 与 kgCO₂e。</p></div><div><button class="btn ghost" id="billPreview">分摊预览</button><button class="btn primary" id="billGenerate">生成月账单</button><button class="btn mint" id="billExport">导出 CSV</button></div></div><div class="module-filters"><label>账单年度<input id="billYear" type="number" min="2020" max="2100"></label><label>账单月份<select id="billMonth"></select></label><label>分摊方式<select id="billMethod"><option value="lease_area">按租赁面积</option><option value="contract_ratio">按合同约定比例</option><option value="operating_days">按实际经营天数</option><option value="manual">人工配置比例</option></select></label><label>状态<select id="billStatus"><option value="">全部</option><option value="0">草稿</option><option value="1">已确认</option><option value="2">已作废</option></select></label><button class="btn ghost" id="billSearch">查询</button></div><div id="billSummary" class="mini-kpis"></div><div id="billResult" class="table-wrap module-result"></div></div></section>
<section id="monthly-reports" class="view module-view"><div class="card report-shell"><div class="toolbar no-print"><div><h2>月度碳排放管理报告中心</h2><p>基于当前综合体和月份动态生成，可打印并导出真实数据库结果。</p></div><div><button class="btn primary" id="reportGenerate">生成预览</button><button class="btn ghost" id="reportPrint">打印报告</button><button class="btn mint" id="reportExport">导出 CSV</button></div></div><div class="module-filters no-print"><label>报告年度<input id="reportYear" type="number" min="2020" max="2100"></label><label>报告月份<select id="reportMonth"></select></label></div><div id="monthlyReport" class="report-content"><div class="table-state">请选择年月生成报告</div></div></div></section>
<section id="data-quality" class="view module-view"><div class="card"><div class="toolbar"><div><h2>数据质量与异常复核中心</h2><p>扫描能耗、设备、审核和排放因子异常，保留复核轨迹并形成处理闭环。</p></div><button class="btn primary" id="qualityScan">执行扫描</button></div><div class="module-filters"><label>开始日期<input id="qualityStart" type="date"></label><label>结束日期<input id="qualityEnd" type="date"></label><label>规则<select id="qualityRule"><option value="">全部规则</option></select></label><label>严重程度<select id="qualitySeverity"><option value="">全部</option><option>高</option><option>中</option><option>低</option></select></label><label>状态<select id="qualityStatus"><option value="">全部</option><option value="0">待处理</option><option value="1">复核中</option><option value="2">已解决</option><option value="3">误报</option></select></label><label>设备编号<input id="qualityDevice" type="number" min="1" placeholder="可选"></label><label>关键字<input id="qualityKeyword" placeholder="标题、设备或记录编码"></label><button class="btn ghost" id="qualitySearch">查询</button><button class="btn ghost" id="qualityReset">重置</button></div><div id="qualitySummary" class="mini-kpis"></div><div id="qualityResult" class="table-wrap module-result"></div><div id="qualityPager" class="table-state"></div></div></section>
<section id="profile" class="view"><div class="profile-grid"><div class="card"><h2>基本信息</h2><div id="profileInfo" class="profile-info">加载中…</div><button class="btn mint" id="editProfile">编辑资料</button><button class="btn ghost" id="changePassword">修改密码</button></div><div class="card"><h2>最近操作</h2><div id="profileLogs" class="profile-logs">加载中…</div></div></div></section>
</main></div><div id="toast" class="toast"></div><dialog id="editor"></dialog><dialog id="helpDialog"><h3>图表说明</h3><p id="helpText"></p><button class="btn primary" id="closeHelp">知道了</button></dialog><script src="${pageContext.request.contextPath}/assets/js/table-sort.js?v=<%= buildVersion %>"></script><script src="${pageContext.request.contextPath}/assets/js/app.js?v=<%= buildVersion %>b"></script><script src="${pageContext.request.contextPath}/assets/js/dashboard-runtime.js?v=<%= buildVersion %>"></script></body></html>
